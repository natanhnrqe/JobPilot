# Copie para .env se quiser alterar os padrões. A aplicação funciona sem .env.
# O backend lê este arquivo (raiz do repositório) e dá precedência ao ambiente real.

# Porta da API
PORT=3000
# Endereço de escuta (padrão: apenas a máquina local)
HOST=127.0.0.1
# Caminho do banco SQLite (padrão: <raiz>/data/jobpilot.sqlite)
# DATABASE_PATH=C:\caminho\opcional\jobpilot.sqlite
# Diretório de dados (padrão: <raiz>/data)
# DATA_DIR=C:\caminho\opcional\data

# --- Integração com IA (Fase 2) — opcional ---
# Sem AI_API_KEY o restante do JobPilot funciona normalmente; apenas a
# extração assistida de vagas fica indisponível.
# AI_API_KEY=sk-...
# Provedor compatível com a API da OpenAI (OpenAI, OpenRouter, Groq, DeepSeek,
# ou endpoint local como Ollama/vLLM).
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=60000
