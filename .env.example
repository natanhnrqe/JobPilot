# Copie para .env se quiser alterar os padrões. A aplicação funciona sem .env.
# Porta da API
PORT=3000
# Endereço de escuta (padrão: apenas a máquina local)
HOST=127.0.0.1
# Caminho do banco SQLite (padrão: <raiz>/data/jobpilot.sqlite)
# DATABASE_PATH=C:\caminho\opcional\jobpilot.sqlite
# Diretório de dados (padrão: <raiz>/data)
# DATA_DIR=C:\caminho\opcional\data