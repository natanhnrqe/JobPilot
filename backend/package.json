{
  "name": "@jobpilot/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "vitest run",
    "db:migrate": "node --disable-warning=ExperimentalWarning --import tsx src/cli/migrate.ts",
    "backup": "node --disable-warning=ExperimentalWarning --import tsx src/cli/backup.ts",
    "restore": "node --disable-warning=ExperimentalWarning --import tsx src/cli/restore.ts",
    "collect": "node --disable-warning=ExperimentalWarning --import tsx src/cli/run-job.ts --job collect"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
